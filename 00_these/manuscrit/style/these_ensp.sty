    \fi%
  }%
}

% -----------------------------------------------------------------------------
% \debutChapitre{titre}{résumé}{mots-clés}
% Affiche la page d'introduction d'un chapitre avec résumé, mots-clés
% et sommaire local (sections + sous-sections).
% Appelé immédiatement après \chapter{titre} dans these2.tex.
% -----------------------------------------------------------------------------
\newcommand{\debutChapitre}[3]{%
  \markboth{Chapitre~\thechapter~-~#1}{}%
  \thispagestyle{partie}%
  \vspace{0.1cm}
  \begin{boiteResume}{R\'esum\'e de la contribution}
    \textit{#2}
  \end{boiteResume}
  \vspace{0.1cm}
  \begin{boiteRemarque}{Mots-cl\'es}
    \color{enspblue}\textit{#3}
  \end{boiteRemarque}
  \vspace{0.1cm}
  \begingroup
    \etocsetstyle{section}%
      {\smallskip}%
      {}%
      {\noindent{\bfseries\small\color{enspblue}%
       \etocnumber\enspace\etocthelinkedname}%
       \nobreak\leaders\hbox{$\mkern0.5mu.\mkern0.5mu$}\hfill\nobreak
       {\small\etocpage}\par}%
      {}%
    \etocsetstyle{subsection}%
      {}%
      {}%
      {\noindent\hspace{1.5em}%
       {\small\etocnumber\enspace\etocthelinkedname}%
       \nobreak\leaders\hbox{$\mkern0.5mu.\mkern0.5mu$}\hfill\nobreak
       {\small\etocpage}\par}%
      {}%
    \etocsetstyle{chapter}{}{}{}{}%
    \etocsetstyle{part}{}{}{}{}%
    \etocsetnexttocdepth{subsection}%
    \etocinline
    \let\origclearpage\clearpage
    \renewcommand{\clearpage}{}%
    \localtableofcontents
    \let\clearpage\origclearpage
  \endgroup
  \clearpage
}
