% =============================================================================
% SECTION 11: BOÎTES STYLISÉES  [palette gris — optimisée impression N&B]
% =============================================================================
%
% RÉFÉRENCE VISUELLE : boiteRemarque (inchangée)
%   colbacktitle = chaptercolor = RGB(70, 70, 70)  — gris foncé
%   colframe     = chaptercolor
%   colback      = gray!4                           — fond quasi-blanc
%
% PRINCIPE DE LA PALETTE :
%   Tous les titres : texte blanc sur fond gris (contraste maximal à l'impression)
%   Tous les fonds  : très légers (gray!3 à gray!7) — lisibilité du texte
%   7 niveaux de gris distincts, du plus clair (Question) au plus sombre (Problématique)
%
%   boiteQuestion      → RGB(125,125,125)  gris clair      fond gray!3
%   boiteResume        → RGB(105,105,105)  gris moyen      fond gray!4
%   boiteHypothese     → RGB( 88, 88, 88)  gris moyen+     fond gray!4
%   boiteRemarque      → RGB( 70, 70, 70)  gris foncé  ← RÉFÉRENCE
%   boiteDefinition    → RGB( 52, 52, 52)  gris très f.    fond gray!5
%   boiteTheoreme      → RGB( 32, 32, 32)  quasi-noir      fond gray!7
%   boiteProblematique → RGB(  0,  0,  0)  noir pur        fond gray!5
%
% =============================================================================

\RequirePackage[most]{tcolorbox}
\tcbuselibrary{skins, breakable}

% --- Palette (les anciennes couleurs steelblue, tealblue, cornflowerblue
%     ne sont plus utilisées et peuvent être supprimées) ---
\definecolor{grisQ}{RGB}{125, 125, 125}   % Question      — gris clair
\definecolor{grisR}{RGB}{105, 105, 105}   % Résumé        — gris moyen
\definecolor{grisH}{RGB}{ 88,  88,  88}   % Hypothèse     — gris moyen+
% chaptercolor = RGB(70,70,70) déjà défini en Section 5  ← Remarque
\definecolor{grisD}{RGB}{ 52,  52,  52}   % Définition    — gris très foncé
\definecolor{grisL}{RGB}{ 42,  42,  42}   % Lemme         — entre Théorème et Définition
\definecolor{grisT}{RGB}{ 32,  32,  32}   % Théorème      — quasi-noir
% black                                   % Problématique — noir pur

% -----------------------------------------------------------------------------
% boiteTheoreme — quasi-noir / fond le plus sombre
% Usage : théorèmes, lemmes, corollaires, propositions
% -----------------------------------------------------------------------------
\newtcolorbox{boiteTheoreme}[2][]{
  enhanced,
  attach boxed title to top left={xshift=4mm, yshift=-3mm},
  fonttitle=\bfseries\sffamily,
  colbacktitle=grisT,
  colframe=grisT,
  colback=gray!7,
  coltitle=white,
  boxrule=0.6pt,
  arc=2pt,
  boxed title style={colframe=grisT, arc=2pt, boxrule=0.6pt},
  title=\strut #2, #1
}

% -----------------------------------------------------------------------------
% boiteLemme — entre quasi-noir et gris très foncé
% Usage : lemmes, résultats intermédiaires, claims
% -----------------------------------------------------------------------------
\newtcolorbox{boiteLemme}[2][]{
  enhanced,
  attach boxed title to top left={xshift=4mm, yshift=-3mm},
  fonttitle=\bfseries\sffamily,
  colbacktitle=grisL,
  colframe=grisL,
  colback=gray!6,
  coltitle=white,
  boxrule=0.6pt,
  arc=2pt,
  boxed title style={colframe=grisL, arc=2pt, boxrule=0.6pt},
  title=\strut #2, #1
}

% -----------------------------------------------------------------------------
