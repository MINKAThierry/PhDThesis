% =============================================================================
% SECTION 11 bis: COMMENTAIRES VISIBLES POUR PREUVES
% =============================================================================
%
% OBJET
%   Cette section fournit trois commandes pour rendre les preuves
%   détaillées (annexes) lisibles par un lecteur non spécialiste, sans
%   alourdir le flux de lecture ni casser la rigueur formelle.
%
%   Les trois commandes s'articulent en deux niveaux :
%
%   L1 — COMMENTAIRES DE LIGNE
%     \cmt{...}          : commentaire inline, texte bleu moyen italique,
%                          indenté sous la ligne commentée
%     \cmtFormule{...}   : annotation sous une équation, symbole ▸,
%                          texte bleu moyen
%
%   L2 — COMMENTAIRES D'ÉTAPE
%     cmtEtape{Titre}    : bloc bleu très clair, titre bleu foncé,
%                          explique le pourquoi d'une étape
%
% PALETTE BLEUE
%   bleuCmtTexte  = RGB(40, 110, 180)   — texte commentaire L1 et L1bis
%   bleuCmtFond   = RGB(230, 242, 255)  — fond cmtEtape
%   bleuCmtTitre  = RGB(0, 70, 140)     — titre cmtEtape
%
% PLACEMENT DANS LE FLUX
%   \cmt doit être placé juste après la ligne commentée.
%   \cmtFormule doit être placé juste après une équation, avant le texte.
%   cmtEtape doit être placé avant le paragraphe de l'étape commentée.
%
% EXEMPLE D'USAGE
%   Puisque $\TV(P,Q) \in [0,1]$ pour toutes distributions $P$ et $Q$,
%   \cmt{La distance en variation totale est comprise entre 0 et 1.}
%   on a $0 \leq 1 - \max \TV(\cdot) \leq 1$,
%   \cmt{Si le max vaut 0, $\Conf = 1$. Si le max vaut 1, $\Conf = 0$.}
%
% =============================================================================

% -----------------------------------------------------------------------------
% Palette bleue des commentaires
% -----------------------------------------------------------------------------
\definecolor{bleuCmtTexte}{RGB}{40, 110, 180}   % texte commentaire L1 et L1bis
\definecolor{bleuCmtFond}{RGB}{230, 242, 255}   % fond cmtEtape
\definecolor{bleuCmtTitre}{RGB}{0, 70, 140}     % titre cmtEtape

% -----------------------------------------------------------------------------
% \cmt — Commentaire inline (L1)
% -----------------------------------------------------------------------------
% Rendu : bloc indenté, texte bleu moyen italique, taille \small.
%         Aucun trait vertical — la couleur seule distingue le commentaire.
% Usage : à placer juste après la ligne ou l'équation commentée.
% -----------------------------------------------------------------------------
\newcommand{\cmt}[1]{%
  \par\vspace{-0.1em}%
  \noindent\hspace{1.5em}%
  \begin{minipage}[t]{\dimexpr\linewidth-1.5em\relax}%
    \small\itshape\color{bleuCmtTexte}%
    #1%
  \end{minipage}%
  \par\vspace{0.1em}%
}

% -----------------------------------------------------------------------------
% \cmtFormule — Commentaire de formule (L1 bis)
% -----------------------------------------------------------------------------
% Rendu : ligne alignée à droite, préfixée par un triangle ▸, en bleu
%         moyen italique, taille \small.
% -----------------------------------------------------------------------------
\newcommand{\cmtFormule}[1]{%
  \begin{flushright}
    \small\itshape\color{bleuCmtTexte}%
    $\blacktriangleright$~#1%
  \end{flushright}
  \vspace{-0.4em}
}

% -----------------------------------------------------------------------------
% cmtEtape — Commentaire d'étape (L2)
% -----------------------------------------------------------------------------
% Rendu : bloc bleu très clair, sans bordure, avec titre bleu foncé en gras
%         suivi du texte. Intégré au flux de la preuve.
% Usage : \begin{cmtEtape}{Titre de l'étape}...\end{cmtEtape}
% -----------------------------------------------------------------------------
\newtcolorbox{cmtEtape}[2][]{%
  enhanced,
  breakable,
  colback=bleuCmtFond,
  colframe=bleuCmtFond,
  boxrule=0pt,
  arc=0pt,
  left=4pt,
  right=4pt,
  top=4pt,
  bottom=4pt,
  fontupper=\small,
  before skip=6pt,
  after skip=6pt,
  #1,
  title={\textbf{#2}},
  coltitle=bleuCmtTitre,
  fonttitle=\bfseries\small,
  attach title to upper,
  after title={\enspace},
} %=============================================================================
