@ConditionalCRO.lemma4_confidentiality_guarantee : ∀ {lam : ℕ} (P : ConditionalCRO.ProtocolInstance lam),
  P.KLmax ≤ P.params.β * P.I → 1 - √(ConditionalCRO.c0 * P.params.β * P.I) ≤ P.Conf
ConditionalCRO.conditional_CRO_trilemma : ∀ (F : ConditionalCRO.ProtocolFamily) (κ : ℝ),
  0 ≤ κ →
    (∀ (lam : ℕ), ConditionalCRO.InstitutionalAssumptions (F.inst lam)) →
      (∀ (lam : ℕ), (F.inst lam).I ≤ κ / ↑lam) →
        ∃ K ε,
          ConditionalCRO.Negligible ε ∧
            ∀ (lam : ℕ),
              64 ≤ lam →
                (F.inst lam).Conf * (F.inst lam).Rel * (F.inst lam).Opp ≤ F.params.Δ / ↑lam + K / ↑lam ^ 2 + ε lam
'ConditionalCRO.lemma4_confidentiality_guarantee' depends on axioms: [propext, Classical.choice, Quot.sound]
