% =============================================================================
% SECTION 8 bis: GESTION DU PLACEMENT DES FLOTTANTS
% =============================================================================
%
% PROBLÈME TRAITÉ
%   Un « flottant » (table, figure, algorithm) n'est pas posé là où il est
%   déclaré : LaTeX le déplace selon la liste de préférences [htbp] et selon
%   des seuils de remplissage de page. Quand une sous-section se réduit à un
%   titre suivi d'un tableau, rien ne retient le flottant : il remonte en haut
%   de page et apparaît AVANT le titre auquel il se rattache.
%
% TROIS LEVIERS SONT FOURNIS ICI
%   1. Seuils assouplis          — actifs d'office, sans effet de bord.
%   2. \ancrerTableaux           — placement absolu [H] pour tous les tableaux.
%   3. \activerBarrieresFlottants — barrière avant chaque sous-section.
%
% USAGE RECOMMANDÉ (dans main.tex, juste après \begin{document})
%   \ancrerTableaux
%   \activerBarrieresFlottants
%
% USAGE LOCALISÉ (un seul chapitre)
%   { \ancrerTableaux  \input{partie4/donnees_validation} }
%   Les accolades limitent l'effet au groupe.
%
% RAPPEL
%   Le package float étant chargé en Section 6, la spécification [H] est
%   disponible tableau par tableau sans rien activer : \begin{table}[H].
% =============================================================================

\RequirePackage{placeins}   % fournit \FloatBarrier

% -----------------------------------------------------------------------------
% 1. Seuils de placement — actifs d'office
% -----------------------------------------------------------------------------
\setcounter{topnumber}{3}            % flottants max en haut de page   (déf. 2)
\setcounter{bottomnumber}{2}         % flottants max en bas de page    (déf. 1)
\setcounter{totalnumber}{5}          % flottants max par page          (déf. 3)
\renewcommand{\topfraction}{0.90}    % part max du haut de page        (déf. 0.7)
\renewcommand{\bottomfraction}{0.80} % part max du bas de page         (déf. 0.3)
\renewcommand{\textfraction}{0.07}   % part min de texte               (déf. 0.2)
\renewcommand{\floatpagefraction}{0.75} % remplissage min d'une page de flottants
\setlength{\intextsep}{10pt plus 2pt minus 2pt}
\setlength{\textfloatsep}{12pt plus 2pt minus 4pt}

% -----------------------------------------------------------------------------
% 2. \ancrerTableaux — placement absolu
% -----------------------------------------------------------------------------
\newcommand{\ancrerTableaux}{%
  \@ifstar
    {\floatplacement{table}{H}\floatplacement{figure}{H}}%
    {\floatplacement{table}{H}}%
}
\newcommand{\libererTableaux}{%
  \floatplacement{table}{htbp}%
  \floatplacement{figure}{htbp}%
}

% -----------------------------------------------------------------------------
% 3. \activerBarrieresFlottants — barrières de section
% -----------------------------------------------------------------------------
\newcommand{\activerBarrieresFlottants}{%
  \let\ENSP@orig@subsection\subsection
  \renewcommand{\subsection}{\FloatBarrier\ENSP@orig@subsection}%
  \let\ENSP@orig@subsubsection\subsubsection
  \renewcommand{\subsubsection}{\FloatBarrier\ENSP@orig@subsubsection}%
}

% Variante plus stricte : barrière également avant chaque \section.
\newcommand{\activerBarrieresFlottantsStrict}{%
  \activerBarrieresFlottants
  \let\ENSP@orig@section\section
  \renewcommand{\section}{\FloatBarrier\ENSP@orig@section}%
}

\makeatother

