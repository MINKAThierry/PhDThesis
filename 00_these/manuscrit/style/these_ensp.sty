% -----------------------------------------------------------------------------
% Définition du langage Lean4
% -----------------------------------------------------------------------------
\lstdefinelanguage{Lean4}{
  % --- Mots-clés de base (tactiques, commandes, structures) ---
  keywords=[1]{theorem, lemma, corollary, definition, structure, inductive,
    def, axiom, instance, variable, variables, import, namespace, end,
    section, open, begin, sorry, exact, refine, apply, intro,
    intros, rw, simp, simp?, by, have, show, suffices, calc,
    fun, let, in, if, then, else, match, with, assume,
    obtain, use, set, unfold, cases, induction, constructor, split,
    injection, congruence, nlinarith, linarith, field_simp, gcongr,
    positivity, filter_upwards, atTop, eventually,
    example, noncomputable, partial, private, protected, public,
    class, extends, where, deriving, mutual, opaque, unsafe},
  % --- Types et structures mathématiques ---
  keywords=[2]{Real, Nat, Int, Rat, Filter, Tendsto, Negligible, BigO, LittleO,
    ProtocolFamily, ProtocolInstance, InstitutionalParams,
    InstitutionalRegime, HeliosParams, zkSNARKParams, TraditionalAuditParams,
    Prop, Type, Sort, Set, List, Array, Option, Prod, Sum, Sigma,
    Bool, String, Unit, Empty, Fin, Vector},
  % --- Constantes et scores spécifiques à la thèse ---
  keywords=[3]{C_score, R_score, O_score, I_val, Conf, Rel, Opp, TV, KL, Adv},
  % --- Styles visuels ---
  keywordstyle=[1]\color{leankeyword}\bfseries,
  keywordstyle=[2]\color{enspgreen}\bfseries,
  keywordstyle=[3]\color{navyblue}\bfseries,
  commentstyle=\color{leancomment}\itshape,
  stringstyle=\color{leanstring}\ttfamily,
  % --- Table de conversion Unicode → LaTeX ---
  literate=
    % Lettres grecques
    {α}{{$\alpha$}}1
    {β}{{$\beta$}}1
    {γ}{{$\gamma$}}1
    {δ}{{$\delta$}}1
    {ε}{{$\varepsilon$}}1
    {η}{{$\eta$}}1
    {λ}{{$\lambda$}}1
    {μ}{{$\mu$}}1
    {π}{{$\pi$}}1
    {σ}{{$\sigma$}}1
    {Δ}{{$\Delta$}}1
    {Γ}{{$\Gamma$}}1
    {Σ}{{$\Sigma$}}1
    {Π}{{$\Pi$}}1
    % Quantificateurs et logique
    {∀}{{$\forall$}}1
    {∃}{{$\exists$}}1
    {ᶠ}{{$^{\mathrm{f}}$}}1
    {∀ᶠ}{{$\forall^{\mathrm{f}}$}}2
    {∧}{{$\land$}}1
    {∨}{{$\lor$}}1
    {¬}{{$\lnot$}}1
    {⊤}{{$\top$}}1
    {⊥}{{$\bot$}}1
    % Ensembles et appartenance
    {ℕ}{{$\mathbb{N}$}}1
    {ℤ}{{$\mathbb{Z}$}}1
    {ℝ}{{$\mathbb{R}$}}1
    {ℚ}{{$\mathbb{Q}$}}1
    {ℂ}{{$\mathbb{C}$}}1
    {ℱ}{{$\mathcal{F}$}}1
    {∈}{{$\in$}}1
    {∉}{{$\notin$}}1
    {⊆}{{$\subseteq$}}1
    {⊂}{{$\subset$}}1
    {∅}{{$\emptyset$}}1
    {∪}{{$\cup$}}1
    {∩}{{$\cap$}}1
    % Opérateurs de comparaison
    {≤}{{$\leq$}}1
    {≥}{{$\geq$}}1
    {≠}{{$\neq$}}1
    {≡}{{$\equiv$}}1
    {≪}{{$\ll$}}1
    {≫}{{$\gg$}}1
    {≈}{{$\approx$}}1
    % Flèches et fonctions
    {→}{{$\to$}}1
    {↦}{{$\mapsto$}}1
    {⇒}{{$\Rightarrow$}}1
    {⇐}{{$\Leftarrow$}}1
    {⇔}{{$\Leftrightarrow$}}1
    {←}{{$\leftarrow$}}1
    % Opérateurs algébriques
    {×}{{$\times$}}1
