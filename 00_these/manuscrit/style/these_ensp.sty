% -----------------------------------------------------------------------------
% boiteArbitre — jalon narratif de la trame de fond
% Niveau : grisQ (le plus clair) — registre narratif, non concurrent du formel
% Titre fixe « L'Arbitre » en bandeau flottant — même patron que toutes les boîtes
% Texte en italique pour marquer le registre distinct
% Usage : \begin{boiteArbitre}...\end{boiteArbitre}  (sans argument)
% -----------------------------------------------------------------------------
\newtcolorbox{boiteArbitre}[1][]{%
  enhanced,
  breakable,
  attach boxed title to top left={xshift=4mm, yshift=-3mm},
  fonttitle=\bfseries\sffamily,
  colbacktitle=grisQ,
  colframe=grisQ,
  colback=gray!3,
  coltitle=white,
  boxrule=0.6pt,
  arc=2pt,
  boxed title style={colframe=grisQ, arc=2pt, boxrule=0.6pt},
  title=\strut L'Arbitre,
  fontupper=\itshape,
  #1
}

% -----------------------------------------------------------------------------
% boiteMethodologie — note transversale méta-discursive
% Niveau : grisQ — même niveau que boiteArbitre, titre variable
